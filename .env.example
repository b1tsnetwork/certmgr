# Einfache ENV-Konfiguration. Für Produktion 32+ zufällige Zeichen generieren.
APP_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-SECRET-WITH-AT-LEAST-32-CHARS
# Mehrere Benutzer: JSON-Objekt aus Login-Name und Passwort (mind. 12 Zeichen).
# Passwort niemals ins Git einchecken.
USERS_JSON={"admin":"CHANGE-ME-SUPER-STRONG-ADMIN-PASSWORD","ops":"CHANGE-ME-SUPER-STRONG-OPS-PASSWORD"}
# Nur für Upgrade von v2: Alten base64-Master-Key unverändert setzen.
# MASTER_KEY=BASE64-OF-EXISTING-32-BYTE-KEY
COOKIE_SECURE=true
# Optional: Seed für erste Anmeldung / Altbestand; sonst UI benutzen.
CERT_NAMES=
CERT_SAN_RULES=
# Optional für EAB der internen CA: im Profil diese ENV-Namen eintragen.
ACME_INTERNAL_KID=
ACME_INTERNAL_HMAC=
ACME_RUN_INTERVAL=43200

# Optional: GHCR-Images verwenden, statt lokal zu bauen. Docker Compose dann mit --no-build starten.
# CERTMANAGER_IMAGE=ghcr.io/DEIN-OWNER/DEIN-REPO-app:latest
# CERTBOT_IMAGE=ghcr.io/DEIN-OWNER/DEIN-REPO-certbot:latest
