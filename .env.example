# Required only on initial startup. 12+ characters; after migration, users are
# administered in the browser and this variable is no longer used for login.
ADMIN_PASSWORD=
# Optional ACME sidecar. Requires --profile acme as well:
ACME_ENABLED=false
ACME_RUN_INTERVAL=43200
ACME_INTERNAL_KID=
ACME_INTERNAL_HMAC=
# WARNING: private key retrieval requires this explicit opt-in AND a private API token.
# Allow only via HTTPS reverse proxy and trusted clients.
CERTWATCH_PRIVATE_EXPORT_ENABLED=false
# Optional manual certificate import: generate a persistent, random, base64-encoded 32-byte key:
# openssl rand -base64 32
# Store value in a protected secret store. Back up key securely alongside application data.
# Set only when manual imports are needed (defaults to off).
CERTWATCH_VAULT_KEY=
# Optional compatibility: legacy PKCS#12 encryption for older Windows servers.
CERTWATCH_LEGACY_PFX=false
# WARNING: unencrypted PKCS#8 variants; leave disabled unless explicitly needed.
CERTWATCH_EXPORT_UNENCRYPTED_KEYS=false
# Published GHCR images can be set as:
CERTWATCH_IMAGE=ghcr.io/b1tsnetwork/certmgr:latest
CERTWATCH_ACME_IMAGE=ghcr.io/b1tsnetwork/certmgr-acme:latest
